{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "-p", "3.13",
        "--from", "serena-agent",
        "serena", "start-mcp-server",
        "--context", "claude-code",
        "--project-from-cwd",
        "--open-web-dashboard", "False"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from", "graphifyy[mcp]",
        "python", "-m", "graphify.serve",
        "graphify-out/graph.json"
      ]
    }
  }
}
