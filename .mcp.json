{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--python", "3.13",
        "--from", "serena-agent",
        "serena", "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd"
      ],
      "env": {
        "PATH": "${HOME}/.local/bin:${PATH}"
      }
    }
  }
}
